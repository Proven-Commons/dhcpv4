/-
  The specification as Lean statements: the challenge file.

  A reviewer who did not write this file approves it, and
  `bar.toml` records the SHA-256 it had then. The proofs live
  in `Proofs` (`Proofs/SpecProofs.lean`); `lake comparator`
  checks that each one proves exactly the statement written
  here. The `sorry` below is expected in this file only.

  The statements use the code under proof named in
  `bar.toml`, in `Dhcp/Value.lean` and `Dhcp/Parse.lean`, and
  the definitions in `Spec/Defs.lean`, part of the
  specification: the option area grammar `OptionArea`, and
  `WF` and its parts.
-/

import Dhcp
import Spec.Defs

open Dhcp

/-! ## The round trips

The statements the slice stands on. Each one is the statement
of the proved theorem of the same shape in
`Proofs/RoundTrip.lean`, over the same well formedness
predicate, `Dhcp.WF`. -/

/-- Parsing the printed form of a well formed message gives
    the message back. -/
theorem Spec.parse_print {m : Message} (hw : WF m) :
    parse (print m) = some m := sorry

/-- Printing a message the parser took gives the canonical
    form of the bytes it was read from. The bytes after the
    first 240 are an option area that the grammar
    `OptionArea` derives, carrying exactly the options of the
    message; and the print is the first 240 bytes as they
    stood, then those options printed, which is the canonical
    option area: pad bytes dropped, zero padding after the
    end byte dropped, and exactly one end byte. So the parser
    takes no input whose option area breaks the grammar, such
    as one with a code byte and no length byte after it, a
    length that runs past the end, or a nonzero byte after
    the end byte. -/
theorem Spec.print_parse {bs : List UInt8} {m : Message}
    (h : parse bs = some m) :
    OptionArea (bs.drop 240) m.options ∧
      print m = bs.take 240 ++ printOptions m.options :=
  sorry

/-! ## Soundness

The parser returns only well formed messages. -/

/-- Every message the parser takes is well formed, in the
    sense of `Dhcp.WF`, the same predicate `Spec.parse_print`
    assumes: op is 1 or 2, htype and hops fit one byte, hlen
    is at most 16, xid and the four addresses fit four bytes,
    secs and flags fit two bytes, chaddr, sname, and file hold
    16, 64, and 128 bytes, every option code runs from 1 to
    254 with a value of at most 255 bytes, and option 53
    stands exactly once with a one byte value from 1 to 8.
    The statement is about the message returned. A parser
    that refuses every input also meets it;
    `Spec.parse_print` rules that parser out. -/
theorem Spec.parse_wf {bs : List UInt8} {m : Message}
    (h : parse bs = some m) : WF m := sorry

